# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MONGODB_URI: Optional MongoDB connection string for production persistence.
# When omitted in local development, BloodConnect persists data to ./data/bloodconnect.json.
MONGODB_URI=""
MONGODB_DB_NAME="bloodconnect"

# ADMIN_EMAIL and ADMIN_PASSWORD: Optional server-side administrator credentials.
# When left empty, the first-run Admin Setup form on /admin-login allows securely claiming an admin password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
